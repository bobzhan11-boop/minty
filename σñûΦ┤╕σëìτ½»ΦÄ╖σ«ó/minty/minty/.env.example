# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# --- Database (SQLite file for local dev) ---
DATABASE_URL="file:./dev.db"

# --- Production database (Turso / libSQL) ---
# When TURSO_DATABASE_URL is set (e.g. on Vercel), the app uses Turso instead of the
# local SQLite file. Leave BLANK for local dev. Get them from the Turso CLI:
#   turso db show <name> --url            -> TURSO_DATABASE_URL  (libsql://...)
#   turso db tokens create <name>         -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- Public site config ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Full WhatsApp number in international format, no + or spaces (e.g. 8613800138000)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Auth ---
# Long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=""

# --- Inquiry email notification ---
# Where new inquiries/orders are emailed.
INQUIRY_NOTIFY_EMAIL=""

# Option A: SMTP (works without owning a domain — e.g. QQ Mail).
# For QQ: host smtp.qq.com, port 465, user = full QQ email,
# pass = the "authorization code" from QQ Mail settings (NOT your login password).
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Option B: Resend REST API (requires a verified sending domain for arbitrary recipients).
RESEND_API_KEY=""
